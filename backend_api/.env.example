# This file serves as an example for the required environment variables.
# Copy this file to .env and replace the placeholder values with your actual credentials.

# -- PostgreSQL Database --
# Used by various services for operational data, alerts, cases, etc.
DB_HOST=postgres
DB_PORT=5432
DB_USER=phantomnet
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
DB_NAME=phantomnet_db

# -- Neo4j Graph Database --
# Used by the Attack Graph and Graph Intelligence services.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD
# Explicitly choose the governed graph backend: "memory" for local/read-only ephemeral graphs or "neo4j" for durable self-hosted graph storage.
PHANTOMNET_GRAPH_BACKEND=memory

# -- Governed AWS Security Group Containment --
# Disabled by default. AWS credentials must be supplied through the workload's standard AWS credential provider chain, never hardcoded here.
PHANTOMNET_AWS_SECURITY_GROUP_CONTAINMENT_ENABLED=false
# Optional integration-test endpoint override for LocalStack; leave unset for real AWS deployments.
PHANTOMNET_AWS_ENDPOINT_URL=
# Comma-separated deployment allowlists. Leave empty to fail closed.
PHANTOMNET_AWS_ALLOWED_REGIONS=us-east-1
PHANTOMNET_AWS_ALLOWED_ACCOUNT_IDS=123456789012
PHANTOMNET_AWS_ALLOWED_CIDRS=203.0.113.0/24
# JSON mapping from a PhantomNet tenant UUID to explicitly permitted Security Group IDs.
PHANTOMNET_AWS_TENANT_SECURITY_GROUP_ALLOWLIST={"00000000-0000-0000-0000-000000000001":["sg-0123456789abcdef0"]}

# -- JWT (JSON Web Token) --
# Critical for securing API endpoints and managing user sessions.
# Use a long, random, and unpredictable string.
JWT_SECRET_KEY=YOUR_SUPER_SECRET_JWT_KEY

# -- Redis --
# Used for caching, rate limiting, and message bus functionalities.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# -- Kafka / Redpanda --
# The primary message bus for event streaming between services.
KAFKA_BOOTSTRAP_SERVERS=redpanda:29092

# -- Application Environment --
# Set to "production" for production deployments to enforce stricter security.
# Set to "development" for local development.
ENVIRONMENT=development
# Canonical safety gate: keep true until dependencies and response adapters are validated in a non-production environment.
PHANTOMNET_SAFE_MODE=true

# -- Cross-Region Telemetry Replication --
# Disabled by default. This transport replicates canonical telemetry only; it never transports containment or response commands.
PHANTOMNET_REGION=local
PHANTOMNET_TELEMETRY_REPLICATION_ENABLED=false
PHANTOMNET_REPLICATION_KAFKA_BOOTSTRAP_SERVERS=
PHANTOMNET_REPLICATION_KAFKA_SECURITY_PROTOCOL=SSL
# Deployment-managed mTLS file paths. Do not store certificates or private keys in source control.
PHANTOMNET_REPLICATION_KAFKA_SSL_CAFILE=
PHANTOMNET_REPLICATION_KAFKA_SSL_CERTFILE=
PHANTOMNET_REPLICATION_KAFKA_SSL_KEYFILE=
