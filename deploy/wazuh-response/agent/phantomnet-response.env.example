# HMAC key used by PhantomNet to sign the command fingerprint sent through Wazuh.
# Store the real value in this root:wazuh mode-0640 file; do not commit it.
PHANTOMNET_WAZUH_RESPONSE_COMMAND_HMAC_KEY=replace-from-secret-store
PHANTOMNET_WAZUH_RESPONSE_COMMAND_HMAC_KEY_ID=wazuh-response-command-key-1

# HTTPS callback into PhantomNet's governed-containment receipt endpoint.
PHANTOMNET_WAZUH_RESPONSE_RECEIPT_URL=https://phantomnet.example.internal/governed-containment/wazuh/receipts
PHANTOMNET_WAZUH_RESPONSE_RECEIPT_HMAC_KEY=replace-from-secret-store
PHANTOMNET_WAZUH_RESPONSE_RECEIPT_HMAC_KEY_ID=wazuh-response-receipt-key-1

# Management path that must remain reachable while a reviewed executor performs isolation.
PHANTOMNET_WAZUH_RESPONSE_ALLOWED_MANAGEMENT_CIDRS=192.0.2.0/24

# This must remain false until a dedicated lab executor has proved isolate and release behavior.
PHANTOMNET_WAZUH_RESPONSE_LOCAL_ENFORCEMENT_ENABLED=false

# Absolute path to an operator-reviewed executor. The bridge refuses to run if absent.
PHANTOMNET_WAZUH_RESPONSE_EXECUTOR=/usr/local/libexec/phantomnet-verified-network-response
