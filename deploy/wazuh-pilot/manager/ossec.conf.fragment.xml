<!--
  Merge this <integration> block inside <ossec_config> in /var/ossec/etc/ossec.conf.
  The referenced custom script only durably queues telemetry for the separate drain service.
  It does not call Wazuh Active Response, the Wazuh API, or any PhantomNet containment endpoint.
-->
<integration>
  <name>custom-phantomnet-pilot</name>
  <level>7</level>
  <group>syscheck,syscollector,sca,rootcheck</group>
  <alert_format>json</alert_format>
</integration>
