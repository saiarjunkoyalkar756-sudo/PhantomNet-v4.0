# Absolute tenant-bound PhantomNet HTTPS stream endpoint from forwarder registration.
PHANTOMNET_WAZUH_STREAM_URL=https://phantomnet.example.internal/wazuh/forwarders/replace-with-forwarder-id/stream

# Read by the Wazuh service account; create as root:wazuh mode 0640.
PHANTOMNET_WAZUH_TOKEN_FILE=/etc/phantomnet/wazuh-forwarder-token

# Durable manager-local queue and sequence state. Keep this path across service restarts.
PHANTOMNET_WAZUH_STATE_FILE=/var/lib/phantomnet-wazuh-pilot/state.json
PHANTOMNET_WAZUH_SPOOL_DIR=/var/lib/phantomnet-wazuh-pilot/spool

# Must match or be narrower than the Wazuh Integrator filters in ossec.conf.
PHANTOMNET_WAZUH_MIN_RULE_LEVEL=7
PHANTOMNET_WAZUH_ALLOWED_GROUPS=syscheck,syscollector,sca,rootcheck
PHANTOMNET_WAZUH_BATCH_SIZE=25
PHANTOMNET_WAZUH_POLL_INTERVAL_SECONDS=1
PHANTOMNET_ALLOW_INSECURE_HTTP=false
LOG_LEVEL=INFO
