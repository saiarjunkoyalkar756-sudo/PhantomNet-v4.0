[Unit]
Description=PhantomNet telemetry-only Wazuh pilot spool drain
Documentation=https://github.com/saiarjunkoyalkar756-sudo/PhantomNet-v4.0/blob/main/docs/WAZUH_INTEGRATION_AND_MIGRATION_GUIDE.md
After=network-online.target wazuh-manager.service
Wants=network-online.target

[Service]
Type=simple
User=wazuh
Group=wazuh
EnvironmentFile=/etc/phantomnet/wazuh-pilot.env
WorkingDirectory=/opt/phantomnet-wazuh-pilot
ExecStart=/usr/bin/python3 -m integrations.wazuh_pilot_forwarder.forwarder drain
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/phantomnet-wazuh-pilot
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
