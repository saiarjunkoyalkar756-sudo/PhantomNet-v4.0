# Absolute HTTPS endpoint returned by POST /wazuh/forwarders for one PhantomNet tenant.
PHANTOMNET_WAZUH_STREAM_URL=https://phantomnet.example.internal/wazuh/forwarders/replace-with-forwarder-id/stream

# Host path to a mode-0600 file containing only the one-time PhantomNet forwarder token.
# Never commit the token file or place the token in this .env file.
PHANTOMNET_WAZUH_TOKEN_FILE=/etc/phantomnet/wazuh-forwarder-token

# Host path to the Wazuh manager's JSON alert stream. The sidecar mounts this read-only.
WAZUH_ALERTS_JSON_PATH=/var/ossec/logs/alerts/alerts.json

# Pilot filters. Start narrow and expand only after acceptance evidence is reviewed.
PHANTOMNET_WAZUH_MIN_RULE_LEVEL=7
PHANTOMNET_WAZUH_ALLOWED_GROUPS=syscheck,syscollector,sca,rootcheck
PHANTOMNET_WAZUH_BATCH_SIZE=25
PHANTOMNET_WAZUH_POLL_INTERVAL_SECONDS=1

# Stable local Docker volume name for replay state; do not remove during normal restarts.
WAZUH_TELEMETRY_STATE_VOLUME=phantomnet_wazuh_telemetry_state
LOG_LEVEL=INFO
