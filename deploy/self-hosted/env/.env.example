# Copy this file to deploy/self-hosted/.env and replace every required placeholder.
# Do not commit the resulting .env file. Use a secret manager or protected host environment in production.

PHANTOMNET_ENVIRONMENT=staging
PHANTOMNET_SAFE_MODE=false
PHANTOMNET_GATEWAY_PORT=8001
PHANTOMNET_PROMETHEUS_PORT=9090
PHANTOMNET_METRICS_RETENTION=15d

PHANTOMNET_POSTGRES_DB=phantomnet
PHANTOMNET_POSTGRES_USER=phantomnet
PHANTOMNET_POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_POSTGRES_PASSWORD
PHANTOMNET_REDIS_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_REDIS_PASSWORD
PHANTOMNET_NEO4J_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_NEO4J_PASSWORD
PHANTOMNET_JWT_SECRET_KEY=REPLACE_WITH_A_32_PLUS_CHARACTER_JWT_SECRET
PHANTOMNET_CONTAINMENT_AUDIT_HMAC_KEY=REPLACE_WITH_A_HIGH_ENTROPY_HMAC_KEY
PHANTOMNET_CONTAINMENT_AUDIT_HMAC_KEY_ID=REPLACE_WITH_A_NON_SECRET_KEY_IDENTIFIER

# Leave governed response adapters disabled until their separate lab runbooks are complete.
PHANTOMNET_ENDPOINT_CONTAINMENT_ENABLED=false
PHANTOMNET_AWS_SECURITY_GROUP_CONTAINMENT_ENABLED=false
PHANTOMNET_WAZUH_RESPONSE_ENABLED=false
